      "id": "ignatius",
      "title": "Ignatius on the road to Rome",
      "ref": "Eusebius, Church History 3.36",
      "intro": "Eusebius says Ignatius was sent from Syria to Rome under military guard, and that he wrote from Smyrna and from Troas. Polycarp's letter shows the Philippians had seen him pass. Nothing records the rest of the way, so the lines between these stops are straight and show only the order.",
      "bbox": [
        10.6,
        34.5,
        38.6,
        43.4
      ],
      "route": [
        "Antioch",
        "Smyrna",
        "Troas",
        "Philippi",
        "Rome"
      ],
      "stops": [
        {
          "place": "Antioch",
          "ref": "Eusebius 3.36.2 to 3",
          "note": "Ignatius is bishop here and is sent to Rome",
          "side": "right"
        },
        {
          "place": "Smyrna",
          "ref": "Eusebius 3.36.5 to 9",
          "note": "He meets Polycarp and writes to Ephesus, Magnesia, Tralles and Rome",
          "side": "left"
        },
        {
          "place": "Troas",
          "ref": "Eusebius 3.36.10",
          "note": "He writes to Philadelphia, Smyrna and Polycarp",
          "side": "left"
        },
        {
          "place": "Philippi",
          "ref": "Polycarp 9, 13",
          "note": "Polycarp says the Philippians saw Ignatius, Rufus and Zosimus",
          "side": "right"
        },
        {
          "place": "Rome",
          "ref": "Ignatius, Romans 5",
          "note": "He writes that he expects to face wild beasts here",
          "side": "right"
        }
      ],
      "refPrefix": ""
