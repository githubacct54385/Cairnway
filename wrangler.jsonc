// Cloudflare Worker that serves the built site (./dist) as static files, plus one endpoint:
// POST /api/report (worker/index.ts), the Crossroads "report a problem" form.
// Deploys are done by .github/workflows/deploy.yml, not by Cloudflare's Git integration:
// each change is uploaded as a version on the "staging" preview URL, and goes live only
// after approval. See docs/DEPLOY.md.
{
  "name": "cairnway",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; every other request is answered straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Where reports become issues.
    "GITHUB_REPO": "githubacct54385/Cairnway"
  },
  // Short-burst limit per connection for POST /api/report (atomic, unlike a KV counter). Per-IP allowance: 5 per minute.
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Holds only the approximate global daily report counter. (It is the namespace that used to hold reporters' contacts; those
  // records are no longer written or read.)
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "60b2e0e2066146ba81b6cee7002d8592" }],
  // The live site at cairnway.<subdomain>.workers.dev.
  "workers_dev": true,
  // Needed for the staging address: staging-cairnway.<subdomain>.workers.dev.
  "preview_urls": true
}
