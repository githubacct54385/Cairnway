// Cloudflare Worker that serves the built site (./dist) as static files, plus one endpoint:
// POST /api/report (worker/index.ts), the Crossroads "report a problem" form.
// Deploys are done by .github/workflows/deploy.yml, not by Cloudflare's Git integration:
// each change is uploaded as a version on the "staging" preview URL, and goes live only
// after approval. See docs/DEPLOY.md.
{
  "name": "cairnway",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* and /admin/* run the Worker; every other request is answered straight from the static files.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "vars": {
    // Where reports become issues.
    "GITHUB_REPO": "githubacct54385/ancient-paths"
  },
  // Private store for reporters' contact details and the per-IP rate limit. This is the namespace the Worker used when it
  // was called ancient-paths, bound by its id so the stored contacts carry over to the renamed Worker.
  "kv_namespaces": [{ "binding": "REPORT_CONTACTS", "id": "60b2e0e2066146ba81b6cee7002d8592" }],
  // The live site at cairnway.<subdomain>.workers.dev.
  "workers_dev": true,
  // Needed for the staging address: staging-cairnway.<subdomain>.workers.dev.
  "preview_urls": true
}
