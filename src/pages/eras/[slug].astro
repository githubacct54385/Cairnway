---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EraMap from '../../components/EraMap.astro';
import type { ComponentProps } from 'astro/types';

export async function getStaticPaths() {
  const eras = await getCollection('eras');
  return eras.map((era) => ({ params: { slug: era.id }, props: { era } }));
}

const { era } = Astro.props;
const { Content, headings } = await render(era);
const allEras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const eraIndex = allEras.findIndex((e) => e.id === era.id);
const prevEra = eraIndex > 0 ? allEras[eraIndex - 1] : undefined;
const nextEra = eraIndex < allEras.length - 1 ? allEras[eraIndex + 1] : undefined;
const bodyHeadings = headings.filter((h) => h.depth === 2);
const { title, summary, dateRange, draft, reviewStatus, reviewLedger, aiReview, overviewMap, mapSection, figures, keyPeople, events, sources } = era.data;
type MapId = ComponentProps<typeof EraMap>['id'];
---

<Base title={title} description={summary}>
  <article class="wrap page">
    <p class="meta"><a href="/">All eras</a></p>
    <h1>{title}</h1>
    <p class="meta">{dateRange}</p>
    <p>{summary}</p>
    {
      draft && (
        <details class="banner draft-status">
          <summary>
            {aiReview
              ? `Sources checked by ${aiReview.model} in ${aiReview.month}. Not yet reviewed by a specialist.`
              : 'Draft: not yet fully reviewed against its sources.'}{' '}
            Show details
          </summary>
          <p>{reviewStatus ?? 'Not yet reviewed against its sources.'} Dates are approximate.</p>
          <p>
            {
              reviewLedger ? (
                <a href={`https://github.com/githubacct54385/ancient-paths/blob/main/${reviewLedger}`}>
                  Review record for this era
                </a>
              ) : (
                <a href="https://github.com/githubacct54385/ancient-paths/tree/main/docs">
                  Review records (the project's docs folder)
                </a>
              )
            }
          </p>
        </details>
      )
    }

    <nav class="era-jump" aria-label="Previous and next eras, at the top">
      {prevEra ? <a href={`/eras/${prevEra.id}/`}>← {prevEra.data.title}</a> : <span />}
      {nextEra ? <a href={`/eras/${nextEra.id}/`}>{nextEra.data.title} →</a> : <span />}
    </nav>

    <nav class="on-page" aria-label="On this page">
      <details class="on-page-details">
        <summary>On this page</summary>
        <ul>
          {figures.length > 0 && <li><a href="#images">Images from the period</a></li>}
          {bodyHeadings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
          {mapSection && <li><a href="#journeys">{mapSection.heading}</a></li>}
          {events.length > 0 && <li><a href="#key-events">Key events</a></li>}
          {keyPeople.length > 0 && <li><a href="#key-people">Key people</a></li>}
          {sources.length > 0 && <li><a href="#sources">Sources for this era</a></li>}
        </ul>
      </details>
    </nav>

    {overviewMap && <EraMap id={overviewMap as MapId} as="h2" />}

    {
      figures.length > 0 && (
        <section data-reveal class="figures" id="images">
          <h2>Images from the period</h2>
          <div class="figure-grid">
            {figures.map((f) => (
              <figure>
                <img src={f.image} alt={f.alt} loading="lazy" />
                <figcaption>
                  {f.caption}
                  <div class="meta">{f.credit}. Licence: {f.licence}.</div>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div data-reveal>
      <Content />
    </div>

    {
      mapSection && (
        <section class="journeys" id="journeys">
          <h2>{mapSection.heading}</h2>
          <p>{mapSection.intro}</p>
          {mapSection.ids.map((id) => (
            <EraMap id={id as MapId} />
          ))}
        </section>
      )
    }

    {
      events.length > 0 && (
        <section data-reveal id="key-events">
          <h2>Key events</h2>
          <ul class="cards">
            {events.map((e) => (
              <li class="card">
                <h3>{e.title}</h3>
                <div class="meta">{e.date}</div>
                <p>{e.summary}</p>
                <div class="meta">Source: {e.source}</div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      keyPeople.length > 0 && (
        <section data-reveal id="key-people">
          <h2>Key people</h2>
          <ul class="cards">
            {keyPeople.map((p) => (
              <li class="card">
                <h3>{p.name}</h3>
                <div class="meta">{p.role}</div>
                <p>{p.summary}</p>
                <div class="meta">Source: {p.source}</div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section data-reveal id="sources">
          <h2>Sources for this era</h2>
          <ul class="sources-list">
            {sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.title}</a> : <strong>{s.title}</strong>}
                {s.author && <span>, {s.author}</span>}
                <div class="meta">
                  License: {s.license}. Checked: {s.checked}. Used for: {s.usedFor}.
                </div>
              </li>
            ))}
          </ul>
          <p class="meta">
            See <a href="/sources/">Sources and permissions</a> for the full list.
          </p>
        </section>
      )
    }
    <nav class="era-nav" aria-label="Previous and next eras">
      {
        prevEra ? (
          <a class="era-nav-prev" href={`/eras/${prevEra.id}/`}>
            <span class="meta">Previous era</span>
            {prevEra.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextEra ? (
          <a class="era-nav-next" href={`/eras/${nextEra.id}/`}>
            <span class="meta">Next era</span>
            {nextEra.data.title}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <button type="button" class="to-top" data-to-top hidden>Back to top</button>
  <script>
    // The contents list is closed on phones and open on wider screens.
  const contents = document.querySelector<HTMLDetailsElement>('.on-page-details');
  if (contents && window.matchMedia('(min-width: 40rem)').matches) {
    contents.open = true;
  }

  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
    if (toTop) {
      const update = () => {
        toTop.hidden = window.scrollY < 600;
      };
      window.addEventListener('scroll', update, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0 }));
      update();
    }
  </script>
</Base>

<style>
  .figure-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .figure-grid figure {
    margin: 0;
  }
  .figure-grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .figure-grid figcaption {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }

  .page [id] {
    scroll-margin-top: 1.25rem;
  }

  .on-page {
    margin: 1.5rem 0 0;
    padding: 0.6rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    background: var(--card);
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }
  .on-page summary {
    cursor: pointer;
    font-weight: 600;
  }
  /* Closed by default on phones so the content starts sooner. A script opens it on wider screens. */
  .draft-status {
    padding: 0.6rem 1rem;
  }
  .draft-status summary {
    cursor: pointer;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .draft-status p {
    margin: 0.5rem 0 0.2rem;
    font-size: 0.95rem;
  }
  .era-jump {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0 0;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }
  .era-jump a {
    text-decoration: none;
  }
  .era-jump a:hover,
  .era-jump a:focus-visible {
    text-decoration: underline;
  }
  .era-jump a:last-child {
    margin-left: auto;
    text-align: right;
  }

  .on-page ul {
    margin: 0.6rem 0 0.2rem;
    padding-left: 1.1rem;
  }
  .on-page li {
    margin-bottom: 0.3rem;
  }
  @media (min-width: 40rem) {
    .on-page ul {
      columns: 2;
      column-gap: 2rem;
    }
  }

  .era-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: system-ui, sans-serif;
  }
  .era-nav a {
    display: block;
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--card);
    color: var(--fg);
    text-decoration: none;
  }
  .era-nav a:hover,
  .era-nav a:focus-visible {
    border-color: var(--accent);
  }
  .era-nav-next {
    text-align: right;
  }
  .era-nav .meta {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 30rem) {
    .era-nav {
      grid-template-columns: 1fr;
    }
    .era-nav-next {
      text-align: left;
    }
  }

  .to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 15;
    padding: 0.6rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--card);
    color: var(--accent);
    font: 0.95rem system-ui, sans-serif;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }
  .to-top[hidden] {
    display: none;
  }
  .to-top:hover,
  .to-top:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
</style>
