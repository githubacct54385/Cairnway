---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const eras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Sources and permissions" description="Every source used on this site, with its license and when it was last checked.">
  <div class="wrap page">
    <h1>Sources and permissions</h1>
    <p>
      This site curates and cites published sources. Text we write ourselves is available under CC BY 4.0. Third-party
      material keeps its own license, listed below. If you believe something here is wrong or improperly used, please
      tell us and we will review it promptly.
    </p>

    {
      eras.map((era) => (
        <section>
          <h2>{era.data.title}</h2>
          <ul class="sources-list">
            {era.data.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.title}</a> : <strong>{s.title}</strong>}
                {s.author && <span>, {s.author}</span>}
                <div class="meta">
                  License: {s.license}. Checked: {s.checked}. Used for: {s.usedFor}.
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section>
      <h2>Maps</h2>
      <ul class="sources-list">
        <li>
          <a href="https://www.naturalearthdata.com/">Natural Earth</a>: coastlines, rivers, lakes and shaded relief.
          Public domain. Made with Natural Earth.
        </li>
        <li>
          City positions, routes and region names were placed by hand from the passages in Acts and are approximate.
          Region names are those used in the first century and are placed roughly, without boundaries.
        </li>
        <li>
          <a href="https://pleiades.stoa.org/">Pleiades gazetteer of ancient places</a>: Creative Commons Attribution
          3.0. The place positions on the Apostolic Age maps were checked against Pleiades in November 2026, and each
          of those maps credits it. The other eras' maps have not yet been checked against it.
        </li>
      </ul>
    </section>
  </div>
</Base>
