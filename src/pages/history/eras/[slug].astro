---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { reportFormUrl } from '../../../lib/report';
import OnThisPage from '../../../components/OnThisPage.astro';
import PrevNext from '../../../components/PrevNext.astro';
import BackToTop from '../../../components/BackToTop.astro';
import EraMap from '../../../components/EraMap.astro';
import type { ComponentProps } from 'astro/types';

export async function getStaticPaths() {
  const eras = await getCollection('eras');
  return eras.map((era) => ({ params: { slug: era.id }, props: { era } }));
}

const { era } = Astro.props;
const { Content, headings } = await render(era);
const allEras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const eraIndex = allEras.findIndex((e) => e.id === era.id);
const prevEra = eraIndex > 0 ? allEras[eraIndex - 1] : undefined;
const nextEra = eraIndex < allEras.length - 1 ? allEras[eraIndex + 1] : undefined;
const bodyHeadings = headings.filter((h) => h.depth === 2);
const { title, summary, dateRange, draft, reviewStatus, reviewLedger, aiReview, overviewMap, mapSection, figures, keyPeople, events, sources } = era.data;
const link = (e?: (typeof allEras)[number]) => (e ? { href: `/history/eras/${e.id}/`, title: e.data.title } : undefined);
const contents = [
  ...(figures.length > 0 ? [{ href: '#images', text: 'Images from the period' }] : []),
  ...bodyHeadings.map((h) => ({ href: `#${h.slug}`, text: h.text })),
  ...(mapSection ? [{ href: '#journeys', text: mapSection.heading }] : []),
  ...(events.length > 0 ? [{ href: '#key-events', text: 'Key events' }] : []),
  ...(keyPeople.length > 0 ? [{ href: '#key-people', text: 'Key people' }] : []),
  ...(sources.length > 0 ? [{ href: '#sources', text: 'Sources for this era' }] : []),
];
type MapId = ComponentProps<typeof EraMap>['id'];
---

<Base title={title} description={summary}>
  <article class="wrap page">
    <p class="meta"><a href="/history/">All eras</a></p>
    <h1>{title}</h1>
    <p class="meta">{dateRange}</p>
    <p>{summary}</p>
    {
      draft && (
        <details class="banner draft-status">
          <summary>
            {aiReview
              ? `Sources checked by ${aiReview.model} in ${aiReview.month}. Not yet reviewed by a specialist.`
              : 'Draft: not yet fully reviewed against its sources.'}{' '}
            Show details
          </summary>
          <p>{reviewStatus ?? 'Not yet reviewed against its sources.'} Dates are approximate.</p>
          <p>
            {
              reviewLedger ? (
                <a href={`https://github.com/githubacct54385/ancient-paths/blob/main/${reviewLedger}`}>
                  Review record for this era
                </a>
              ) : (
                <a href="https://github.com/githubacct54385/ancient-paths/tree/main/docs">
                  Review records (the project's docs folder)
                </a>
              )
            }
          </p>
        </details>
      )
    }

    <PrevNext variant="top" noun="era" prev={link(prevEra)} next={link(nextEra)} />

    <OnThisPage items={contents} />

    {overviewMap && <EraMap id={overviewMap as MapId} as="h2" />}

    {
      figures.length > 0 && (
        <section data-reveal class="figures" id="images">
          <h2>Images from the period</h2>
          <div class="figure-grid">
            {figures.map((f) => (
              <figure>
                <img src={f.image} alt={f.alt} loading="lazy" />
                <figcaption>
                  {f.caption}
                  <div class="meta">{f.credit}. Licence: {f.licence}.</div>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div data-reveal>
      <Content />
    </div>

    {
      mapSection && (
        <section class="journeys" id="journeys">
          <h2>{mapSection.heading}</h2>
          <p>{mapSection.intro}</p>
          {mapSection.ids.map((id) => (
            <EraMap id={id as MapId} />
          ))}
        </section>
      )
    }

    {
      events.length > 0 && (
        <section data-reveal id="key-events">
          <h2>Key events</h2>
          <ul class="cards">
            {events.map((e) => (
              <li class="card">
                <h3>{e.title}</h3>
                <div class="meta">{e.date}</div>
                <p>{e.summary}</p>
                <div class="meta">Source: {e.source}</div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      keyPeople.length > 0 && (
        <section data-reveal id="key-people">
          <h2>Key people</h2>
          <ul class="cards">
            {keyPeople.map((p) => (
              <li class="card">
                <h3>{p.name}</h3>
                <div class="meta">{p.role}</div>
                <p>{p.summary}</p>
                <div class="meta">Source: {p.source}</div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section data-reveal id="sources">
          <h2>Sources for this era</h2>
          <ul class="sources-list">
            {sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.title}</a> : <strong>{s.title}</strong>}
                {s.author && <span>, {s.author}</span>}
                <div class="meta">
                  License: {s.license}. Checked: {s.checked}. Used for: {s.usedFor}.
                </div>
              </li>
            ))}
          </ul>
          <p class="meta">
            See <a href="/history/sources/">Sources and permissions</a> for the full list.
          </p>
        </section>
      )
    }
    <p class="report">
      <a href={reportFormUrl('history', title, `/history/eras/${era.id}/`)}>Report a problem with this era</a>
    </p>
    <PrevNext variant="bottom" noun="era" prev={link(prevEra)} next={link(nextEra)} />
  </article>

  <BackToTop />
</Base>

<style>
  .figure-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .figure-grid figure {
    margin: 0;
  }
  .figure-grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .figure-grid figcaption {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }

  .page [id] {
    scroll-margin-top: 1.25rem;
  }
</style>
