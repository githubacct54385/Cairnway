---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Reviewer-only page. Not linked from the site, kept out of the sitemap and robots, and marked noindex.
const eras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const rank = { high: 0, medium: 1, note: 2 } as const;
const total = eras.reduce((sum, era) => sum + era.data.flags.length, 0);
---

<Base title="Review flags" noindex searchable={false}>
  <article class="wrap page">
    <p class="meta">Reviewers only. Not linked from the site.</p>
    <h1>Open review flags</h1>
    <p>{total} open flags across {eras.length} eras. The full ledgers are in the repository under <code>docs/</code>.</p>
    {
      eras.map((era) => (
        <section>
          <h2>{era.data.title} <span class="meta">({era.data.flags.length})</span></h2>
          {era.data.flags.length === 0 && <p class="meta">No flags.</p>}
          <ul>
            {[...era.data.flags]
              .sort((a, b) => rank[a.severity] - rank[b.severity])
              .map((flag) => (
                <li class={flag.severity}>
                  <strong>{flag.severity}:</strong> {flag.text}
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </article>
</Base>
