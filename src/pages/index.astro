---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const eras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const first = eras[0];
const last = eras[eras.length - 1];
const spanStart = first.data.startYear;
const spanEnd = last.data.endYear;
const span = spanEnd - spanStart;

// Position on the bar, as a percentage of the whole span. The bar is drawn to scale: each era's width is its length in years.
const at = (year: number) => ((year - spanStart) / span) * 100;

// Century ticks. A tick is dropped if it would sit too close to the end label.
const ticks = [500, 1000, 1500, 2000].filter((y) => y > spanStart && at(y) < 88);

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV', 'XVI'];
const numeral = (i: number) => ROMAN[i] ?? String(i + 1);
const draftCount = eras.filter((era) => era.data.draft).length;
const aiCount = eras.filter((era) => era.data.aiReview).length;
const unchecked = eras.length - aiCount;
---

<Base>
  <section class="hero">
    <div class="hero-inner wrap">
      <h1>{SITE.title}</h1>
      <p>The story of Christianity, one era at a time, with a source for every claim.</p>
      <a class="button" href={`/eras/${first.id}/`}>Start with the first era</a>
    </div>
  </section>

  <div class="home-wrap">
    <section class="overview" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="overview-title">Timeline, AD {spanStart} to {spanEnd}</h2>

      <div class="scale" aria-hidden="true">
        <div class="bar">
          {
            eras.map((era, i) => (
              <span
                class={`seg seg-${i % 2}`}
                style={`left: ${at(era.data.startYear)}%; width: ${at(era.data.endYear) - at(era.data.startYear)}%;`}
              />
            ))
          }
        </div>
        <div class="ticks">
          <span class="tick tick-start" style="left: 0%">{spanStart}</span>
          {ticks.map((y) => <span class="tick" style={`left: ${at(y)}%`}>{y}</span>)}
          <span class="tick tick-end" style={`left: 100%`}>{spanEnd}</span>
        </div>
      </div>
      <p class="scale-note">Drawn to scale: each era's width is its length in years. The list below gives every era in order.</p>
    </section>

    {
      draftCount > 0 && (
        <p class="scale-note draft-note">
          {aiCount > 0 && `${aiCount} of ${eras.length} eras ${aiCount === 1 ? 'has' : 'have'} had their sources checked by an AI model. `}
          {unchecked > 0 && (unchecked === eras.length ? 'Every era is still a draft, not yet fully checked against its sources. ' : `The other ${unchecked} ${unchecked === 1 ? 'is still a draft' : 'are still drafts'}, not yet fully checked against their sources. `)}
          No era has yet been reviewed by a specialist. Each era page says what has been checked.
        </p>
      )
    }
    <ol id="eras" class="era-list">
      {
        eras.map((era, i) => (
          <li class="era-row" id={`era-${era.id}`} data-reveal>
            <div class="era-meta">
              <span class={`era-num seg-${i % 2}`} aria-hidden="true">{numeral(i)}</span>
              <span class="range">{era.data.dateRange}</span>
            </div>
            <div class="era-body">
              <h3><a href={`/eras/${era.id}/`}>{era.data.title}</a></h3>
              <p>{era.data.summary}</p>
              <p class="row-actions">
                <a class="read-link" href={`/eras/${era.id}/`}>
                  Read this era <span aria-hidden="true" class="arrow">→</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .hero {
    min-height: 0;
    padding: 1.75rem 1rem 1.25rem;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    margin-bottom: 0.5rem;
  }
  .hero p {
    margin-bottom: 1rem;
  }

  /* The home column is wider than the reading column, so the timeline and the era list
     have room on tablet and desktop. Phones get the full width minus the gutter. */
  .home-wrap {
    width: min(100% - 2rem, 54rem);
    margin-inline: auto;
    padding-bottom: 3rem;
  }

  /* The scale: one bar for the whole span, drawn to scale. It never scrolls and never
     overlaps, because it is always the width of the column. */
  .overview {
    margin-bottom: 1.5rem;
  }
  .overview-title {
    font-size: 0.85rem;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }
  .scale {
    position: relative;
  }
  .bar {
    position: relative;
    height: 16px;
    border-radius: 8px;
    background: var(--rule);
    overflow: hidden;
  }
  .seg {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--accent);
    border-right: 2px solid var(--bg);
  }
  .seg-1 {
    opacity: 0.55;
  }
  .ticks {
    position: relative;
    height: 1.5rem;
    margin-top: 0.35rem;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    line-height: 1;
    padding-top: 0.3rem;
  }
  .tick::before {
    content: '';
    position: absolute;
    top: -0.35rem;
    left: 50%;
    width: 1px;
    height: 0.3rem;
    background: var(--muted);
  }
  .tick-start {
    transform: none;
  }
  .tick-start::before {
    left: 0;
  }
  .tick-end {
    transform: translateX(-100%);
  }
  .tick-end::before {
    left: auto;
    right: 0;
  }
  .scale-note {
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.6rem 0 0;
  }

  /* The era list. One row per era, in order. Each row is its own line, so nothing can overlap. */
  .era-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .era-row {
    display: grid;
    gap: 0.5rem 2rem;
    border-top: 1px solid var(--rule);
    padding: 1.25rem 0;
  }
  .era-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .era-num {
    font-family: system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--accent);
    min-width: 1.5rem;
  }
  .arrow {
    margin-left: 0.1em;
  }
  .era-num.seg-1 {
    opacity: 0.7;
  }
  .range {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .era-body h3 {
    font-size: 1.4rem;
    margin: 0 0 0.35rem;
  }
  .era-body h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  .era-body h3 a:hover,
  .era-body h3 a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .era-body p {
    margin: 0 0 0.5rem;
  }
  .row-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .read-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }
  .pill {
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--muted);
  }

  /* Tablet and desktop: the dates sit in a left column, the era reads on the right. */
  @media (min-width: 720px) {
    .era-row {
      grid-template-columns: 11rem 1fr;
      align-items: start;
    }
    .era-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
      padding-top: 0.2rem;
    }
    .era-num {
      min-width: 0;
    }
    .era-body h3 {
      font-size: 1.5rem;
    }
  }
</style>
