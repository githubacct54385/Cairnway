---
import Base from '../layouts/Base.astro';
import { UMBRELLA, SITE } from '../config';

// Placeholder umbrella homepage. The real one, with a door to each section, comes in the next step of CHR-1.
---

<Base title={UMBRELLA.name} description={UMBRELLA.description} searchable={false}>
  <div class="wrap page">
    <h1>{UMBRELLA.name}</h1>
    <p>{UMBRELLA.description}</p>
    <p><a class="button" href="/history/">{SITE.title}: the history of the church</a></p>
  </div>
</Base>
