---
import Base from '../../layouts/Base.astro';
import { loadCrossroads } from '../../lib/crossroads';

const { topics, bodies, teachings } = await loadCrossroads();
---

<Base title="Sources and permissions" description="Every document used on Crossroads, its issuer, edition and rights status." section="crossroads" searchable={false}>
  <div class="wrap page">
    <h1>Sources and permissions</h1>
    <p>
      Every document used on Crossroads, with the body that issued it, the edition read, and whether we may quote it.
      This is a working log, not legal advice. Where rights are unclear we link and summarize instead of quoting.
    </p>
    {
      topics
        .filter((t) => teachings.some((e) => e.data.topic === t.id))
        .map((t) => (
          <section>
            <h2>{t.data.title}</h2>
            <ul class="sources-list">
              {bodies.flatMap((b) =>
                teachings
                  .filter((e) => e.data.topic === t.id && e.data.body === b.id)
                  .flatMap((e) => [
                    { doc: e.data.document, rights: e.data.rights },
                    ...e.data.additionalDocuments.map((doc) => ({ doc, rights: doc.rights })),
                  ])
                  .map(({ doc, rights }) => (
                    <li>
                      <a href={doc.url}>{doc.title}</a>, {doc.section}
                      <div class="meta">
                        {b.data.name}. Issued by {doc.issuer}. Date: {doc.date}. Edition: {doc.edition}.
                        Rights: {rights.status.replace('-', ' ')}; {rights.note} Checked {rights.checked}.
                      </div>
                    </li>
                  )),
              )}
            </ul>
          </section>
        ))
    }
  </div>
</Base>
