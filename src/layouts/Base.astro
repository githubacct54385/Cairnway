---
import '../styles/global.css';
import { SITE, UMBRELLA, CROSSROADS } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Whether Pagefind should index this page's main content. */
  searchable?: boolean;
  /** Keep this page out of search engines, whatever the pre-launch setting. */
  noindex?: boolean;
  /** Which part of the site this page belongs to. Chooses the header links, footer and title suffix. */
  section?: 'home' | 'history' | 'crossroads';
}

const { title, description, searchable = true, noindex = false, section = 'history' } = Astro.props;
const sectionName = { home: UMBRELLA.name, history: SITE.title, crossroads: CROSSROADS.name }[section];
const defaultDescription = { home: UMBRELLA.description, history: SITE.description, crossroads: CROSSROADS.description }[section];
const fullTitle = title && title !== sectionName ? `${title} · ${sectionName}` : sectionName;
const metaDescription = description ?? defaultDescription;
const current = Astro.url.pathname;
const sectionLinks =
  section === 'history'
    ? [
        ['/history/search/', 'Search'],
        ['/history/sources/', 'Sources'],
        ['/history/about/', 'About'],
      ]
    : section === 'crossroads'
      ? [
          [`${CROSSROADS.base}/`, 'Topics'],
          [`${CROSSROADS.base}/churches/`, 'Churches'],
          [`${CROSSROADS.base}/sources/`, 'Sources'],
          [`${CROSSROADS.base}/about/`, 'About'],
        ]
      : [];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const mainAttrs = searchable ? { 'data-pagefind-body': '' } : {};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {(SITE.prelaunch || noindex) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/logo.svg" alt="" width="28" height="28" />
        {UMBRELLA.name}
      </a>
      <nav aria-label="Sections">
        <a href="/history/" aria-current={section === 'history' ? 'true' : undefined}>{SITE.title}</a>
        <a href={`${CROSSROADS.base}/`} aria-current={section === 'crossroads' ? 'true' : undefined}>{CROSSROADS.name}</a>
      </nav>
    </header>
    {
      sectionLinks.length > 0 && (
        <nav class="subnav" aria-label={`${sectionName} pages`}>
          <a class="subnav-title" href={section === 'history' ? '/history/' : `${CROSSROADS.base}/`}>{sectionName}</a>
          {sectionLinks.map(([href, label]) => (
            <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      )
    }
    <main id="main" {...mainAttrs}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        {
          section === 'crossroads' ? (
            <>
              <p>
                Crossroads summarizes what churches officially teach, in our own words, and links to the documents. It is
                not itself a church authority and does not speak for any church. See <a href={`${CROSSROADS.base}/about/`}>how
                Crossroads works</a>.
              </p>
              <p>
                Spotted a misrepresentation, a broken source or a rights concern? Every topic page has a report link that
                fills in the page for you.
              </p>
            </>
          ) : section === 'history' ? (
            <>
              <p>
                This site summarizes published sources and is not itself a scholarly authority. Please consult the works we
                cite. See <a href="/history/sources/">Sources and permissions</a>.
              </p>
              <p>
                Made by a Christian, with the aim of presenting the evidence fairly. <a href="/history/about/">About this site</a>.
              </p>
              <p>
                Spotted a mistake or a license problem? <a href="https://github.com/githubacct54385/ancient-paths/issues/new/choose">Open an issue on GitHub</a>. Reviews
                happen as time permits.
              </p>
            </>
          ) : (
            <p>
              Made by a Christian, with the aim of presenting the evidence fairly. Each section says how its pages are
              sourced and checked.
            </p>
          )
        }
      </div>
    </footer>
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
