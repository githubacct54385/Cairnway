---
interface Props {
  /** The area the search starts in. Visitors can change it with the filter under the box. */
  area: string;
  intro: string;
}
const { area, intro } = Astro.props;
---

<div class="wrap page">
  <h1>Search</h1>
  <p>{intro}</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search" data-area={area}></div>
  <noscript><p>Search needs JavaScript. You can still browse every page from the menu above.</p></noscript>
  <p class="meta" id="search-dev-note" hidden>
    The search index is created by the production build (npm run build). It is not available in npm run dev.
  </p>
</div>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var box = document.getElementById('search');
    if (window.PagefindUI) {
      var ui = new window.PagefindUI({ element: '#search', showImages: false });
      // Start inside the visitor's own area; the "area" filter lets them widen it.
      ui.triggerFilters({ area: box.dataset.area });
    } else {
      // The search index only exists in a built site, so the script is missing under "npm run dev".
      document.getElementById('search-dev-note').hidden = false;
    }
  });
</script>
