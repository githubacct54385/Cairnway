---
import type { CollectionEntry } from 'astro:content';
import { reportUrl, entrySlug, TIERS } from '../lib/crossroads';
import { CROSSROADS } from '../config';

interface Props {
  entry: CollectionEntry<'teachings'>;
  body: CollectionEntry<'bodies'>;
  topicTitle: string;
  /** Page the report link points back to. */
  path: string;
  /** Which name leads the card: the church (on a topic page) or the topic (on a church page). */
  lead?: 'body' | 'topic';
}

const { entry, body, topicTitle, path, lead = 'body' } = Astro.props;
const d = entry.data;
const voice = d.voice;
const heading = lead === 'body' ? body.data.name : topicTitle;
const sub = lead === 'body' ? body.data.tradition : body.data.name;
const label = voice ? `${body.data.name}: ${voice.label}` : body.data.name;
---

<article class="teaching" id={entrySlug(entry)}>
  <h3>{heading}</h3>
  <p class="docline">{sub}</p>
  {
    voice && (
      <p class="docline">
        <strong>{voice.label}</strong> {voice.tier && <span class="tag">{TIERS[voice.tier]}</span>}
      </p>
    )
  }

  <p class="label">Our summary</p>
  {d.summary.split('\n\n').map((para) => <p>{para}</p>)}

  {
    d.points.length > 0 && (
      <dl>
        {d.points.map((p) => (
          <>
            <dt>{p.question}</dt>
            <dd>
              {p.answer} <span class="at">({p.at})</span>
            </dd>
          </>
        ))}
      </dl>
    )
  }

  {
    d.excerpt && (
      <>
        <p class="label">From the document</p>
        <blockquote class="excerpt">
          <p>{d.excerpt.text}</p>
          <cite>
            {d.document.title}, {d.excerpt.at}
          </cite>
        </blockquote>
      </>
    )
  }

  {
    d.scripture.length > 0 && (
      <>
        <p class="label">Scripture the document cites</p>
        <p>
          {d.scripture.join('; ')}.{' '}
          {d.scriptureNote && <span class="meta">{d.scriptureNote}</span>}
        </p>
      </>
    )
  }

  <p class="label">{d.additionalDocuments.length > 0 ? 'The documents' : 'The document'}</p>
  {
    [d.document, ...d.additionalDocuments].map((doc) => (
      <p>
        <a href={doc.url}>{doc.title}</a>, {doc.section}.{' '}
        {doc.tier && <span class="tag">{TIERS[doc.tier]}</span>}
        <br />
        <span class="docline">
          Issued by {doc.issuer}. Date: {doc.date}. Read in: {doc.edition}.
        </span>
      </p>
    ))
  }

  <details>
    <summary>How this entry was checked</summary>
    <p>
      <strong>{d.review.status === 'draft' ? 'Draft.' : 'Checked by an AI model.'}</strong>
      {d.review.note}
    </p>
    <p>
      <strong>Rights ({d.rights.status.replace('-', ' ')}):</strong> {d.rights.note} Checked {d.rights.checked}.
    </p>
    {
      d.additionalDocuments.map((doc) => (
        <p>
          <strong>Rights, {doc.title} ({doc.rights.status.replace('-', ' ')}):</strong> {doc.rights.note} Checked {doc.rights.checked}.
        </p>
      ))
    }
  </details>

  <p class="report">
    <a href={reportUrl(`${label}: ${topicTitle}`, path)}>Report a problem with this entry</a>
  </p>
</article>
